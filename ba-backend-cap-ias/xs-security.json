{
  "xsappname": "ba-backend-cap-ias",
  "tenant-mode": "dedicated",
  "description": "SAP CAP Backend for Bachelor Thesis - SAP IAS Integration (Trial Account)",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin scope - Full access to all operations"
    },
    {
      "name": "$XSAPPNAME.Manager",
      "description": "Manager scope - Read and write access to orders"
    },
    {
      "name": "$XSAPPNAME.User",
      "description": "User scope - Read-only access to orders"
    },
    {
      "name": "$XSAPPNAME.Observer",
      "description": "Observer scope - Read-only access (for H2 testing)"
    }
  ],
  "attributes": [
    {
      "name": "email",
      "description": "User email from SAP IAS",
      "valueType": "string"
    },
    {
      "name": "givenName",
      "description": "User first name from SAP IAS",
      "valueType": "string"
    },
    {
      "name": "familyName",
      "description": "User last name from SAP IAS",
      "valueType": "string"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Administrator - Full CRUD access",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ],
      "attribute-references": [
        "email",
        "givenName",
        "familyName"
      ]
    },
    {
      "name": "Manager",
      "description": "Manager - Read and write access to orders",
      "scope-references": [
        "$XSAPPNAME.Manager"
      ],
      "attribute-references": [
        "email",
        "givenName",
        "familyName"
      ]
    },
    {
      "name": "User",
      "description": "User - Read-only access to orders",
      "scope-references": [
        "$XSAPPNAME.User"
      ],
      "attribute-references": [
        "email",
        "givenName",
        "familyName"
      ]
    },
    {
      "name": "Observer",
      "description": "Observer - Read-only access (H2 Hypothesis Testing)",
      "scope-references": [
        "$XSAPPNAME.Observer"
      ],
      "attribute-references": ["email"]
    }
  ],
  "role-collections": [
    {
      "name": "BA_Admin",
      "description": "Bachelor Thesis - Admin Role Collection",
      "role-template-references": ["$XSAPPNAME.Admin"]
    },
    {
      "name": "BA_Manager",
      "description": "Bachelor Thesis - Manager Role Collection",
      "role-template-references": ["$XSAPPNAME.Manager"]
    },
    {
      "name": "BA_User",
      "description": "Bachelor Thesis - User Role Collection",
      "role-template-references": ["$XSAPPNAME.User"]
    },
    {
      "name": "BA_Observer",
      "description": "Bachelor Thesis - Observer Role Collection (H2 Testing)",
      "role-template-references": ["$XSAPPNAME.Observe"]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "http://localhost:4200/**",
      "https://*.hana.ondemand.com/**",
      "https://*.cfapps.eu10.hana.ondemand.com/**",
      "https://*.cfapps.us10.hana.ondemand.com/**"
    ],
    "grant-types": [
      "authorization_code",
      "refresh_token"
    ],
    "token-validity": 3600,
    "refresh-token-validity": 43200
  }
}

