{
  "name": "ba-backend-cap-ias-cds",
  "version": "1.0.0",
  "description": "SAP CAP Backend for Bachelor Thesis - SAP IAS Integration",
  "license": "ISC",
  "repository": "<Add your repository here>",
  "devDependencies": {
    "@sap/cds-dk": "^9.4.1"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "roles": [
                "Admin"
              ],
              "email": "admin@example.com"
            },
            "manager": {
              "roles": [
                "Manager"
              ],
              "email": "manager@example.com"
            },
            "user": {
              "roles": [
                "User"
              ],
              "email": "user@example.com"
            },
            "observer": {
              "roles": [
                "Observer"
              ],
              "email": "observer@example.com"
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "db": {
        "[development]": {
          "kind": "sql"
        },
        "[production]": {
          "kind": "hana"
        }
      }
    },
    "odata": {
      "v4": {
        "enabled": true
      }
    },
    "features": {
      "fetch_csrf": true
    }
  }
}

